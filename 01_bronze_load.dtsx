      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEA5E0FE-7775-4491-B879-76D826DA1D3C}"
          SQLTask:SqlStatementSource="-- Ensure logging schema and execution audit table exist&#xA;IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'logging')&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA logging');&#xA;END;&#xA;&#xA;&#xA;IF OBJECT_ID('logging.etl_load_log', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE logging.etl_load_log (&#xA;        LogID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        BatchID INT NOT NULL,&#xA;        SourceName VARCHAR(255) NOT NULL,&#xA;        TargetTable VARCHAR(255) NOT NULL,&#xA;        RowCountLoaded INT NULL,&#xA;        Status VARCHAR(50) NOT NULL,&#xA;        LoadedAt DATETIME DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::BatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
