    <DTS:Executable
      DTS:refId="Package\ensure_etl_load_log"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C89027C0-1F0C-477D-9154-E2B85F511862}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ensure_etl_load_log"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEA5E0FE-7775-4491-B879-76D826DA1D3C}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = N'logging')&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA logging;');&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.tables WHERE object_id = OBJECT_ID(N'logging.etl_load_log'))&#xA;BEGIN&#xA;    CREATE TABLE logging.etl_load_log (&#xA;        BatchID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        PackageName VARCHAR(100),&#xA;        StartTime DATETIME DEFAULT GETDATE(),&#xA;        EndTime DATETIME NULL,&#xA;        Status VARCHAR(50) DEFAULT 'Running'&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\generate_batch_id"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{45A3EE88-B97B-4960-86DE-36658B8C5794}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="generate_batch_id"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EEA5E0FE-7775-4491-B879-76D826DA1D3C}"
          SQLTask:SqlStatementSource="INSERT INTO logging.etl_load_log (PackageName, StartTime, Status)&#xA;VALUES (?, GETDATE(), 'Running');&#xA;&#xA;SELECT SCOPE_IDENTITY();"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::BatchID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="System::CreatorComputerName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\log_customers"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C053384D-5F88-4F70-907A-9FCA9BFE43CB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
