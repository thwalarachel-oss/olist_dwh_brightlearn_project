        <SQLTask:SqlTaskData
          SQLTask:Connection="{59888AA3-6774-419C-9D9A-73A9B3502920}"
          SQLTask:SqlStatementSource="-- 1. CREATE DATABASE IF IT DOES NOT EXIST&#xA;&#xA;IF DB_ID('olist_dwh') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE olist_dwh;&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
