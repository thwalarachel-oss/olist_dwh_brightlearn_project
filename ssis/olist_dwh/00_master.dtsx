      DTS:ObjectName="02_create schemas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{59888AA3-6774-419C-9D9A-73A9B3502920}"
          SQLTask:SqlStatementSource="-- 2. USE DATABASE&#xA;&#xA;USE olist_dwh;&#xA;&#xA;&#xA;-- 3. CREATE BRONZE SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('bronze') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;END;&#xA;&#xA;&#xA;-- 4. CREATE SILVER SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('silver') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA silver');&#xA;END;&#xA;&#xA;&#xA;-- 5. CREATE GOLD SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('gold') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA gold');&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03_create_bronze_tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2D4A3E8F-90B2-4A7E-AE9B-29F374E407C7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_create_bronze_tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{59888AA3-6774-419C-9D9A-73A9B3502920}"
          SQLTask:SqlStatementSource="-- 2. USE DATABASE&#xA;&#xA;USE olist_dwh;&#xA;&#xA;&#xA;-- 3. CREATE BRONZE SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('bronze') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;END;&#xA;&#xA;&#xA;-- 4. CREATE SILVER SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('silver') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA silver');&#xA;END;&#xA;&#xA;&#xA;-- 5. CREATE GOLD SCHEMA IF IT DOES NOT EXIST&#xA;&#xA;IF SCHEMA_ID('gold') IS NULL&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA gold');&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04_create_silver_tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6196DB03-C201-429D-877A-CD6DC500CC40}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_create_silver_tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{59888AA3-6774-419C-9D9A-73A9B3502920}"
          SQLTask:SqlStatementSource="&#xA;-- =============================================&#xA;-- PROJECT: OLIST DATA WAREHOUSE&#xA;-- DATABASE: olist_dwh&#xA;-- LAYER: SILVER&#xA;-- PURPOSE: CREATE SILVER TABLES&#xA;-- =============================================&#xA;&#xA;USE olist_dwh;&#xA;GO&#xA;&#xA;-- 1. DIM_CUSTOMERS TABLE&#xA;&#xA;IF OBJECT_ID('silver.dim_customers', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.dim_customers&#xA;    (&#xA;        customer_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;        customer_id VARCHAR(250) NOT NULL,&#xA;        customer_unique_id VARCHAR(250) NOT NULL,&#xA;        zip_code_prefix VARCHAR(250),&#xA;        city VARCHAR(250),&#xA;        state VARCHAR(250)&#xA;    );&#xA;END;&#xA;&#xA;-- 2. DIM_PRODUCTS TABLE&#xA;&#xA;IF OBJECT_ID('silver.dim_products', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.dim_products&#xA;    (&#xA;        product_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;        product_id VARCHAR(250) NOT NULL,&#xA;        product_category_name VARCHAR(250),&#xA;        product_category_name_english VARCHAR(250),&#xA;        product_weight_g INT,&#xA;        product_length_cm INT,&#xA;        product_height_cm INT,&#xA;        product_width_cm INT&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- 3. DIM_SELLERS TABLE&#xA;&#xA;IF OBJECT_ID('silver.dim_sellers', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.dim_sellers&#xA;    (&#xA;        seller_key INT IDENTITY(1,1) PRIMARY KEY,&#xA;        seller_id VARCHAR(50) NOT NULL,&#xA;        zip_code_prefix VARCHAR(250),&#xA;        city VARCHAR(250),&#xA;        state VARCHAR(250)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- 4. FACT_ORDERS TABLE&#xA;&#xA;IF OBJECT_ID('silver.fact_orders', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.fact_orders&#xA;    (&#xA;        order_id VARCHAR(250) NOT NULL,&#xA;        customer_id VARCHAR(250) NOT NULL,&#xA;        order_status VARCHAR(250),&#xA;        order_purchase_timestamp DATETIME,&#xA;        order_approved_at DATETIME,&#xA;        order_delivered_carrier_date DATETIME,&#xA;        order_delivered_customer_date DATETIME,&#xA;        order_estimated_delivery_date DATETIME&#xA;    );&#xA;END;&#xA;&#xA;&#xA;-- 5. FACT_ORDER_ITEMS TABLE&#xA;&#xA;IF OBJECT_ID('silver.fact_order_items', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.fact_order_items&#xA;    (&#xA;        order_id VARCHAR(250) NOT NULL,&#xA;        order_item_id INT NOT NULL,&#xA;        product_id VARCHAR(250) NOT NULL,&#xA;        seller_id VARCHAR(250) NOT NULL,&#xA;        shipping_limit_date DATETIME,&#xA;        price DECIMAL(10,2),&#xA;        freight_value DECIMAL(10,2)&#xA;    );&#xA;END;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
